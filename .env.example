# API de FACTTIC
FACTTIC_API_URL=https://facttic-web.it10.com.ar

# Credencial de servicio para el sitio público (solo se usa en el servidor).
# Hoy es la cuenta admin; se reemplaza por un usuario de solo lectura cuando
# el backend lo cree, o se elimina cuando los GET pasen a ser públicos.
FACTTIC_API_USER=
FACTTIC_API_PASS=

# Traductor del panel: LibreTranslate (software libre, AGPL). Sin esto usa la
# instancia de Disroot, que anda sin clave. Para la oficial: TRADUCTOR_URL=
# https://libretranslate.com/translate y TRADUCTOR_CLAVE con la clave.
TRADUCTOR_URL=
TRADUCTOR_CLAVE=
