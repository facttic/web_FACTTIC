# API de FACTTIC
FACTTIC_API_URL=https://facttic-web.it10.com.ar

# Credencial de servicio, solo del lado del servidor. El sitio lee sin
# credencial —los GET de la API son públicos—; esto hace falta únicamente para
# que el formulario de contacto pueda enviar.
FACTTIC_API_USER=
FACTTIC_API_PASS=

# Traductor del panel: LibreTranslate (software libre, AGPL). Sin esto usa la
# instancia de Disroot, que anda sin clave. Para la oficial: TRADUCTOR_URL=
# https://libretranslate.com/translate y TRADUCTOR_CLAVE con la clave.
TRADUCTOR_URL=
TRADUCTOR_CLAVE=
